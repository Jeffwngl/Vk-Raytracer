#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8)
uniform image2D outputImage;

struct Sphere {
    vec3 center;
    float radius;
    vec3 color;
};

layout(
    std430,
    set = 0,
    binding = 1
) readonly buffer SphereBuffer {
    Sphere spheres[];
};


struct Ray {
    vec3 origin;
    vec3 direction;
};


struct Camera {
    vec3 position;
    vec3 forwards;
};


struct HitRecord {
    vec3 position;
    vec3 normal;

    float t;
    bool frontFace;

    vec3 color;
};


vec3 skyColor(vec3 direction) {
    // Convert y from [-1, 1] to [0, 1]
    float t = 0.5 * (direction.y + 1.0);

    return mix(
        vec3(1.0, 1.0, 1.0),
        vec3(0.5, 0.7, 1.0),
        t
    );
}


vec3 rayAt(Ray ray, float t) {
    return ray.origin + t * ray.direction;
}


